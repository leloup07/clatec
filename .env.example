# ═══════════════════════════════════════════════════════════
# CLATEC — Environment Variables
# ═══════════════════════════════════════════════════════════
# Production: set these in Vercel → Project → Settings → Environment Variables.
# Local dev: copy to .env.local (git-ignored) and fill in values.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# ─── App (public) ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://clatec.consulting

# ─── Supabase (server only) ───────────────────────────────
# The browser never talks to Supabase directly, so no anon key is needed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic Claude (server only) ───────────────────────
ANTHROPIC_API_KEY=
# Optional override; default is claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ─── Stripe (server only) — use sk_test_ until go-live ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Resend (server only, optional: internal notifications) ─
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@clatec.consulting
ADMIN_EMAIL=

# ─── Booking link released after payment + KYC (server only)
CALENDLY_URL=https://calendly.com/your-account/consultation

# ─── Admin panel (server only) ────────────────────────────
# ADMIN_PASSWORD: at least 12 characters (20+ recommended)
# ADMIN_SESSION_SECRET: at least 32 random characters (openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
